# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER@localhost:5432/jobmatch_ai"

# Separate database used by `npm test`. Database tests are skipped if unset.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/jobmatch_ai_test"

# Auth.js secret (required). Generate with: openssl rand -base64 33
AUTH_SECRET=""
# Needed when running `next start` locally or behind a proxy.
AUTH_TRUST_HOST=true

# LLM provider: "mock" or "anthropic". If unset, Anthropic is used when
# ANTHROPIC_API_KEY is present, otherwise the deterministic mock.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-opus-5"

# Max LLM calls per user per hour, per operation type.
LLM_RATE_LIMIT_PER_HOUR=20

# Private directory for uploaded CVs (never inside public/).
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_BYTES=5242880
